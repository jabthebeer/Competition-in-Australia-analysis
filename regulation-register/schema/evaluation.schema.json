{
  "$defs": {
    "Document": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "path": {
          "description": "Path relative to the repository root",
          "pattern": "^[A-Za-z0-9_./-]+$",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "label",
        "path"
      ],
      "title": "Document",
      "type": "object"
    },
    "Equation": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "text": {
          "description": "Plain text; _{...} marks a subscript, ^{...} a superscript and hat{...} an estimate (rendered by the menu explorer)",
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Equation",
      "type": "object"
    },
    "EstimatorRow": {
      "additionalProperties": false,
      "description": "One estimator layer's estimate of one outcome, for the side-by-side comparison.",
      "properties": {
        "outcome": {
          "title": "Outcome",
          "type": "string"
        },
        "layer": {
          "minLength": 1,
          "title": "Layer",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "estimate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimate"
        },
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "p_value": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P Value"
        },
        "mde_80": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mde 80"
        },
        "registered": {
          "default": false,
          "title": "Registered",
          "type": "boolean"
        }
      },
      "required": [
        "outcome",
        "layer",
        "label"
      ],
      "title": "EstimatorRow",
      "type": "object"
    },
    "EventPoint": {
      "additionalProperties": false,
      "properties": {
        "period": {
          "title": "Period",
          "type": "string"
        },
        "k": {
          "title": "K",
          "type": "integer"
        },
        "estimate": {
          "title": "Estimate",
          "type": "number"
        },
        "low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Low"
        },
        "high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "High"
        }
      },
      "required": [
        "period",
        "k",
        "estimate"
      ],
      "title": "EventPoint",
      "type": "object"
    },
    "EventStudy": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "title": "Outcome",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "reference": {
          "title": "Reference",
          "type": "string"
        },
        "band": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Band"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/EventPoint"
          },
          "minItems": 2,
          "title": "Points",
          "type": "array"
        },
        "markers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Marker"
          },
          "title": "Markers",
          "type": "array"
        },
        "caption": {
          "default": "",
          "title": "Caption",
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "title",
        "unit",
        "reference",
        "points"
      ],
      "title": "EventStudy",
      "type": "object"
    },
    "Interval": {
      "additionalProperties": false,
      "properties": {
        "low": {
          "title": "Low",
          "type": "number"
        },
        "high": {
          "title": "High",
          "type": "number"
        },
        "level": {
          "default": 0.9,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Level",
          "type": "number"
        }
      },
      "required": [
        "low",
        "high"
      ],
      "title": "Interval",
      "type": "object"
    },
    "Marker": {
      "additionalProperties": false,
      "properties": {
        "k": {
          "title": "K",
          "type": "number"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "k",
        "label"
      ],
      "title": "Marker",
      "type": "object"
    },
    "Method": {
      "additionalProperties": false,
      "description": "The econometrics in depth: what was estimated, how, and what it assumes.",
      "properties": {
        "summary": {
          "description": "The estimator in one or two sentences",
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "equations": {
          "items": {
            "$ref": "#/$defs/Equation"
          },
          "minItems": 1,
          "title": "Equations",
          "type": "array"
        },
        "terms": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Term"
          },
          "title": "Terms",
          "type": "array"
        },
        "estimand": {
          "description": "What the main coefficient measures, in words",
          "minLength": 1,
          "title": "Estimand",
          "type": "string"
        },
        "identification": {
          "description": "The assumption that makes it causal",
          "minLength": 1,
          "title": "Identification",
          "type": "string"
        },
        "inference": {
          "description": "How uncertainty is measured",
          "minLength": 1,
          "title": "Inference",
          "type": "string"
        },
        "steps": {
          "description": "What was done, in order",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "summary",
        "equations",
        "estimand",
        "identification",
        "inference",
        "steps"
      ],
      "title": "Method",
      "type": "object"
    },
    "NoEffectRange": {
      "additionalProperties": false,
      "description": "What the estimator gives where there was no reform (placebos), drawn around zero.",
      "properties": {
        "low": {
          "title": "Low",
          "type": "number"
        },
        "high": {
          "title": "High",
          "type": "number"
        },
        "basis": {
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "low",
        "high",
        "basis"
      ],
      "title": "NoEffectRange",
      "type": "object"
    },
    "OutcomeResult": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "category": {
          "enum": [
            "competition",
            "prices",
            "productivity"
          ],
          "title": "Category",
          "type": "string"
        },
        "role": {
          "enum": [
            "primary",
            "secondary",
            "descriptive"
          ],
          "title": "Role",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "baseline": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline"
        },
        "baseline_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Label"
        },
        "estimate": {
          "title": "Estimate",
          "type": "number"
        },
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "no_effect_range": {
          "$ref": "#/$defs/NoEffectRange"
        },
        "p_value": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P Value"
        },
        "inference": {
          "minLength": 1,
          "title": "Inference",
          "type": "string"
        },
        "mde_80": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Smallest effect detectable with 80% power",
          "title": "Mde 80"
        },
        "finding": {
          "enum": [
            "increase",
            "decrease",
            "no-detectable-effect",
            "not-identified",
            "descriptive-only"
          ],
          "title": "Finding",
          "type": "string"
        },
        "grade": {
          "anyOf": [
            {
              "enum": [
                "Strong",
                "Moderate",
                "Weak",
                "Not identified"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grade"
        },
        "preregistered": {
          "title": "Preregistered",
          "type": "boolean"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "category",
        "role",
        "unit",
        "estimate",
        "no_effect_range",
        "inference",
        "finding",
        "preregistered"
      ],
      "title": "OutcomeResult",
      "type": "object"
    },
    "ResultsTable": {
      "additionalProperties": false,
      "description": "A regression table in the usual academic layout: numbered columns (estimators or specifications), one\npanel per outcome, coefficients with stars, spread and p-value, then sample rows, a footer of shared rows\n(fixed effects, controls) and notes.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/TableColumn"
          },
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "panels": {
          "items": {
            "$ref": "#/$defs/TablePanel"
          },
          "minItems": 1,
          "title": "Panels",
          "type": "array"
        },
        "footer": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TableRow"
          },
          "title": "Footer",
          "type": "array"
        },
        "spread_label": {
          "description": "What the parentheses hold",
          "minLength": 1,
          "title": "Spread Label",
          "type": "string"
        },
        "notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "columns",
        "panels",
        "spread_label"
      ],
      "title": "ResultsTable",
      "type": "object"
    },
    "TableCoef": {
      "additionalProperties": false,
      "description": "One coefficient in a results table: the estimate, its spread (in parentheses) and p-value (in brackets).",
      "properties": {
        "estimate": {
          "title": "Estimate",
          "type": "number"
        },
        "spread": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spread"
        },
        "p_value": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P Value"
        },
        "registered": {
          "default": false,
          "title": "Registered",
          "type": "boolean"
        }
      },
      "required": [
        "estimate"
      ],
      "title": "TableCoef",
      "type": "object"
    },
    "TableColumn": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Spanning header shared by adjacent columns",
          "title": "Group"
        }
      },
      "required": [
        "label"
      ],
      "title": "TableColumn",
      "type": "object"
    },
    "TablePanel": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/TableRow"
          },
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "title",
        "rows"
      ],
      "title": "TablePanel",
      "type": "object"
    },
    "TableRow": {
      "additionalProperties": false,
      "description": "A coefficient row (one coefficient per column) or a text row (sample sizes, fixed effects, tests).",
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "coefficients": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/TableCoef"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Coefficients",
          "type": "array"
        },
        "values": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "label"
      ],
      "title": "TableRow",
      "type": "object"
    },
    "Term": {
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "description": "Plain text; _{...} marks a subscript, ^{...} a superscript and hat{...} an estimate (rendered by the menu explorer)",
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "meaning": {
          "minLength": 1,
          "title": "Meaning",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "meaning"
      ],
      "title": "Term",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "records": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Records",
      "type": "array"
    },
    "family": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Family"
    },
    "follows": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "An earlier evaluation of some of the same records that this one revisits; both stay on file",
      "title": "Follows"
    },
    "evaluated_on": {
      "format": "date",
      "title": "Evaluated On",
      "type": "string"
    },
    "hypothesis": {
      "enum": [
        "enhancing",
        "weakening",
        "mixed",
        "unclear"
      ],
      "title": "Hypothesis",
      "type": "string"
    },
    "design": {
      "minLength": 1,
      "title": "Design",
      "type": "string"
    },
    "comparison": {
      "minLength": 1,
      "title": "Comparison",
      "type": "string"
    },
    "window": {
      "minLength": 1,
      "title": "Window",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "supports-enhancing",
        "supports-weakening",
        "contradicts-enhancing",
        "contradicts-weakening",
        "detects-increase",
        "detects-decrease",
        "inconclusive",
        "not-identified"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "finding_label": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Finding Label",
      "type": "string"
    },
    "grade": {
      "enum": [
        "Strong",
        "Moderate",
        "Weak",
        "Not identified"
      ],
      "title": "Grade",
      "type": "string"
    },
    "grade_reason": {
      "minLength": 1,
      "title": "Grade Reason",
      "type": "string"
    },
    "headline": {
      "minLength": 1,
      "title": "Headline",
      "type": "string"
    },
    "category_summaries": {
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "enum": [
          "competition",
          "prices",
          "productivity"
        ]
      },
      "title": "Category Summaries",
      "type": "object"
    },
    "key_insights": {
      "default": [],
      "description": "Plain-language summary for non-specialists: question, comparison, finding, precision, meaning",
      "items": {
        "type": "string"
      },
      "title": "Key Insights",
      "type": "array"
    },
    "method": {
      "anyOf": [
        {
          "$ref": "#/$defs/Method"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "preregistered": {
      "title": "Preregistered",
      "type": "boolean"
    },
    "outcomes": {
      "items": {
        "$ref": "#/$defs/OutcomeResult"
      },
      "minItems": 1,
      "title": "Outcomes",
      "type": "array"
    },
    "event_studies": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EventStudy"
      },
      "title": "Event Studies",
      "type": "array"
    },
    "caveats": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Caveats",
      "type": "array"
    },
    "documents": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Document"
      },
      "title": "Documents",
      "type": "array"
    },
    "built_by": {
      "description": "Script that wrote this file from the analysis outputs",
      "minLength": 1,
      "title": "Built By",
      "type": "string"
    },
    "supersedes": {
      "default": [],
      "description": "Earlier evaluations this one replaces; the menu shows them as archived, below it",
      "items": {
        "type": "string"
      },
      "title": "Supersedes",
      "type": "array"
    },
    "evaluated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "When the registered run was made (orders a day's work)",
      "title": "Evaluated At"
    },
    "estimators": {
      "default": [],
      "description": "Every estimator layer side by side for each outcome; the registered one marked",
      "items": {
        "$ref": "#/$defs/EstimatorRow"
      },
      "title": "Estimators",
      "type": "array"
    },
    "tables": {
      "default": [],
      "description": "Regression tables in the usual academic layout",
      "items": {
        "$ref": "#/$defs/ResultsTable"
      },
      "title": "Tables",
      "type": "array"
    }
  },
  "required": [
    "id",
    "title",
    "records",
    "evaluated_on",
    "hypothesis",
    "design",
    "comparison",
    "window",
    "verdict",
    "finding_label",
    "grade",
    "grade_reason",
    "headline",
    "category_summaries",
    "preregistered",
    "outcomes",
    "built_by"
  ],
  "title": "Evaluation result",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
