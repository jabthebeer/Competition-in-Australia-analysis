{
  "$defs": {
    "Document": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "path": {
          "description": "Path relative to the repository root",
          "pattern": "^[A-Za-z0-9_./-]+$",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "label",
        "path"
      ],
      "title": "Document",
      "type": "object"
    },
    "EventPoint": {
      "additionalProperties": false,
      "properties": {
        "period": {
          "title": "Period",
          "type": "string"
        },
        "k": {
          "title": "K",
          "type": "integer"
        },
        "estimate": {
          "title": "Estimate",
          "type": "number"
        },
        "low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Low"
        },
        "high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "High"
        }
      },
      "required": [
        "period",
        "k",
        "estimate"
      ],
      "title": "EventPoint",
      "type": "object"
    },
    "EventStudy": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "title": "Outcome",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "reference": {
          "title": "Reference",
          "type": "string"
        },
        "band": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Band"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/EventPoint"
          },
          "minItems": 2,
          "title": "Points",
          "type": "array"
        },
        "markers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Marker"
          },
          "title": "Markers",
          "type": "array"
        },
        "caption": {
          "default": "",
          "title": "Caption",
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "title",
        "unit",
        "reference",
        "points"
      ],
      "title": "EventStudy",
      "type": "object"
    },
    "Interval": {
      "additionalProperties": false,
      "properties": {
        "low": {
          "title": "Low",
          "type": "number"
        },
        "high": {
          "title": "High",
          "type": "number"
        },
        "level": {
          "default": 0.9,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Level",
          "type": "number"
        }
      },
      "required": [
        "low",
        "high"
      ],
      "title": "Interval",
      "type": "object"
    },
    "Marker": {
      "additionalProperties": false,
      "properties": {
        "k": {
          "title": "K",
          "type": "number"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "k",
        "label"
      ],
      "title": "Marker",
      "type": "object"
    },
    "NoEffectRange": {
      "additionalProperties": false,
      "description": "What the estimator gives where there was no reform (placebos), drawn around zero.",
      "properties": {
        "low": {
          "title": "Low",
          "type": "number"
        },
        "high": {
          "title": "High",
          "type": "number"
        },
        "basis": {
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "low",
        "high",
        "basis"
      ],
      "title": "NoEffectRange",
      "type": "object"
    },
    "OutcomeResult": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "category": {
          "enum": [
            "competition",
            "prices",
            "productivity"
          ],
          "title": "Category",
          "type": "string"
        },
        "role": {
          "enum": [
            "primary",
            "secondary",
            "descriptive"
          ],
          "title": "Role",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "baseline": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline"
        },
        "baseline_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Label"
        },
        "estimate": {
          "title": "Estimate",
          "type": "number"
        },
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "no_effect_range": {
          "$ref": "#/$defs/NoEffectRange"
        },
        "p_value": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P Value"
        },
        "inference": {
          "minLength": 1,
          "title": "Inference",
          "type": "string"
        },
        "mde_80": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Smallest effect detectable with 80% power",
          "title": "Mde 80"
        },
        "finding": {
          "enum": [
            "increase",
            "decrease",
            "no-detectable-effect",
            "not-identified",
            "descriptive-only"
          ],
          "title": "Finding",
          "type": "string"
        },
        "grade": {
          "anyOf": [
            {
              "enum": [
                "Strong",
                "Moderate",
                "Weak",
                "Not identified"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grade"
        },
        "preregistered": {
          "title": "Preregistered",
          "type": "boolean"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "category",
        "role",
        "unit",
        "estimate",
        "no_effect_range",
        "inference",
        "finding",
        "preregistered"
      ],
      "title": "OutcomeResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "records": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Records",
      "type": "array"
    },
    "family": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Family"
    },
    "evaluated_on": {
      "format": "date",
      "title": "Evaluated On",
      "type": "string"
    },
    "hypothesis": {
      "enum": [
        "enhancing",
        "weakening",
        "mixed",
        "unclear"
      ],
      "title": "Hypothesis",
      "type": "string"
    },
    "design": {
      "minLength": 1,
      "title": "Design",
      "type": "string"
    },
    "comparison": {
      "minLength": 1,
      "title": "Comparison",
      "type": "string"
    },
    "window": {
      "minLength": 1,
      "title": "Window",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "supports-enhancing",
        "supports-weakening",
        "inconclusive"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "finding_label": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Finding Label",
      "type": "string"
    },
    "grade": {
      "enum": [
        "Strong",
        "Moderate",
        "Weak",
        "Not identified"
      ],
      "title": "Grade",
      "type": "string"
    },
    "grade_reason": {
      "minLength": 1,
      "title": "Grade Reason",
      "type": "string"
    },
    "headline": {
      "minLength": 1,
      "title": "Headline",
      "type": "string"
    },
    "category_summaries": {
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "enum": [
          "competition",
          "prices",
          "productivity"
        ]
      },
      "title": "Category Summaries",
      "type": "object"
    },
    "preregistered": {
      "title": "Preregistered",
      "type": "boolean"
    },
    "outcomes": {
      "items": {
        "$ref": "#/$defs/OutcomeResult"
      },
      "minItems": 1,
      "title": "Outcomes",
      "type": "array"
    },
    "event_studies": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EventStudy"
      },
      "title": "Event Studies",
      "type": "array"
    },
    "caveats": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Caveats",
      "type": "array"
    },
    "documents": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Document"
      },
      "title": "Documents",
      "type": "array"
    },
    "built_by": {
      "description": "Script that wrote this file from the analysis outputs",
      "minLength": 1,
      "title": "Built By",
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "records",
    "evaluated_on",
    "hypothesis",
    "design",
    "comparison",
    "window",
    "verdict",
    "finding_label",
    "grade",
    "grade_reason",
    "headline",
    "category_summaries",
    "preregistered",
    "outcomes",
    "built_by"
  ],
  "title": "Evaluation result",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
