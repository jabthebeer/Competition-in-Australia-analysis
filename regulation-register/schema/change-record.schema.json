{
  "$defs": {
    "Assessment": {
      "additionalProperties": false,
      "description": "The item marked against the productivity impact framework (``register/framework.py``).",
      "properties": {
        "summary": {
          "description": "Plain English: what it does to productivity and competition",
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "marks": {
          "items": {
            "$ref": "#/$defs/DriverMark"
          },
          "minItems": 1,
          "title": "Marks",
          "type": "array"
        },
        "main_driver": {
          "enum": [
            "entry-exit",
            "competition",
            "market-integration",
            "capital",
            "labour",
            "burden",
            "innovation",
            "prices-taxes"
          ],
          "title": "Main Driver",
          "type": "string"
        },
        "reach": {
          "enum": [
            "narrow",
            "sector",
            "multi-sector",
            "economy-wide"
          ],
          "title": "Reach",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "confidence_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Note"
        },
        "evidence": {
          "default": [],
          "description": "Sources for the marks beyond the record's own",
          "items": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "framework": {
          "default": "1.0",
          "description": "Framework version the marks follow",
          "title": "Framework",
          "type": "string"
        },
        "assessed_on": {
          "format": "date",
          "title": "Assessed On",
          "type": "string"
        }
      },
      "required": [
        "summary",
        "marks",
        "main_driver",
        "reach",
        "confidence",
        "assessed_on"
      ],
      "title": "Assessment",
      "type": "object"
    },
    "Commencement": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "what": {
          "description": "Which provisions, or what took effect",
          "minLength": 1,
          "title": "What",
          "type": "string"
        },
        "source": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "primary": {
          "default": false,
          "description": "The commencement that changes competition conditions; used as the effective date",
          "title": "Primary",
          "type": "boolean"
        }
      },
      "required": [
        "date",
        "what",
        "source"
      ],
      "title": "Commencement",
      "type": "object"
    },
    "DatedSource": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "source": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "title": "DatedSource",
      "type": "object"
    },
    "Dates": {
      "additionalProperties": false,
      "properties": {
        "announced": {
          "$ref": "#/$defs/DatedSource",
          "default": {
            "date": null,
            "source": null
          }
        },
        "assent_or_made": {
          "$ref": "#/$defs/DatedSource",
          "default": {
            "date": null,
            "source": null
          }
        },
        "commenced": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Commencement"
          },
          "title": "Commenced",
          "type": "array"
        }
      },
      "title": "Dates",
      "type": "object"
    },
    "DriverMark": {
      "additionalProperties": false,
      "description": "One driver's mark: -2 (major harm) to +2 (major gain). Drivers left out are marked 0.",
      "properties": {
        "driver": {
          "enum": [
            "entry-exit",
            "competition",
            "market-integration",
            "capital",
            "labour",
            "burden",
            "innovation",
            "prices-taxes"
          ],
          "title": "Driver",
          "type": "string"
        },
        "mark": {
          "maximum": 2,
          "minimum": -2,
          "title": "Mark",
          "type": "integer"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "driver",
        "mark",
        "reason"
      ],
      "title": "DriverMark",
      "type": "object"
    },
    "HistoryEvent": {
      "additionalProperties": false,
      "description": "A later change to the item's law or setting: an amendment, easing, review, repeal or replacement.",
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "kind": {
          "enum": [
            "announced",
            "amended",
            "eased",
            "tightened",
            "extended",
            "reviewed",
            "repealed",
            "replaced"
          ],
          "title": "Kind",
          "type": "string"
        },
        "what": {
          "description": "Plain English: what changed",
          "minLength": 1,
          "title": "What",
          "type": "string"
        },
        "source": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The register record that covers this change, if any",
          "title": "Record"
        }
      },
      "required": [
        "date",
        "kind",
        "what",
        "source"
      ],
      "title": "HistoryEvent",
      "type": "object"
    },
    "Industry": {
      "additionalProperties": false,
      "properties": {
        "anzsic": {
          "title": "Anzsic",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "exposure": {
          "enum": [
            "direct",
            "indirect"
          ],
          "title": "Exposure",
          "type": "string"
        }
      },
      "required": [
        "anzsic",
        "name",
        "exposure"
      ],
      "title": "Industry",
      "type": "object"
    },
    "Instrument": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "register_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Register Url"
        },
        "register_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Register identifier, e.g. C2021A00123",
          "title": "Register Id"
        },
        "role": {
          "enum": [
            "principal",
            "amending",
            "regulation",
            "code",
            "other"
          ],
          "title": "Role",
          "type": "string"
        },
        "provisions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provisions"
        }
      },
      "required": [
        "title",
        "role"
      ],
      "title": "Instrument",
      "type": "object"
    },
    "Responsibility": {
      "additionalProperties": false,
      "description": "A government body responsible for the item, from the bodies registry (``regulation-register/bodies.json``).",
      "properties": {
        "body": {
          "description": "Id in regulation-register/bodies.json",
          "title": "Body",
          "type": "string"
        },
        "role": {
          "enum": [
            "administers",
            "regulates",
            "policy"
          ],
          "title": "Role",
          "type": "string"
        },
        "source": {
          "description": "Where the responsibility is stated (administrative arrangements, Act page)",
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "body",
        "role",
        "source"
      ],
      "title": "Responsibility",
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "description": "Whether a person has checked the record. Desk-research drafts start as ``draft``.",
      "properties": {
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "reviewed"
          ],
          "title": "Status",
          "type": "string"
        },
        "by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "By"
        },
        "on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "title": "Review",
      "type": "object"
    },
    "Verification": {
      "additionalProperties": false,
      "properties": {
        "dates": {
          "title": "Dates",
          "type": "boolean"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "dates"
      ],
      "title": "Verification",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "default": "reform",
      "description": "reform, existing setting or non-legislative barrier",
      "enum": [
        "reform",
        "setting",
        "barrier"
      ],
      "title": "Kind",
      "type": "string"
    },
    "family": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Shared by one reform across jurisdictions",
      "title": "Family"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "jurisdiction": {
      "enum": [
        "CTH",
        "NSW",
        "VIC",
        "QLD",
        "WA",
        "SA",
        "TAS",
        "ACT",
        "NT"
      ],
      "title": "Jurisdiction",
      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "instruments": {
      "default": [],
      "description": "Required for reforms and settings",
      "items": {
        "$ref": "#/$defs/Instrument"
      },
      "title": "Instruments",
      "type": "array"
    },
    "dates": {
      "$ref": "#/$defs/Dates"
    },
    "direction": {
      "description": "Hypothesised competition effect, to be tested",
      "enum": [
        "enhancing",
        "weakening",
        "mixed",
        "unclear"
      ],
      "title": "Direction",
      "type": "string"
    },
    "direction_rationale": {
      "minLength": 1,
      "title": "Direction Rationale",
      "type": "string"
    },
    "direction_sources": {
      "default": [],
      "items": {
        "format": "uri",
        "maxLength": 2083,
        "minLength": 1,
        "type": "string"
      },
      "title": "Direction Sources",
      "type": "array"
    },
    "channels": {
      "items": {
        "enum": [
          "barriers",
          "number-or-type",
          "ability-incentive",
          "prices-market-share",
          "consumer-choice"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Channels",
      "type": "array"
    },
    "industries": {
      "default": [],
      "description": "Required unless the item is economy-wide",
      "items": {
        "$ref": "#/$defs/Industry"
      },
      "title": "Industries",
      "type": "array"
    },
    "comparison": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Comparison group for an econometric evaluation",
      "title": "Comparison"
    },
    "confounders": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Confounders",
      "type": "array"
    },
    "price_series": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Price Series"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "verified": {
      "$ref": "#/$defs/Verification"
    },
    "review": {
      "$ref": "#/$defs/Review",
      "default": {
        "status": "draft",
        "by": null,
        "on": null,
        "notes": null
      }
    },
    "assessment": {
      "anyOf": [
        {
          "$ref": "#/$defs/Assessment"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "responsible": {
      "default": [],
      "description": "Departments and regulators responsible",
      "items": {
        "$ref": "#/$defs/Responsibility"
      },
      "title": "Responsible",
      "type": "array"
    },
    "history": {
      "default": [],
      "description": "Later changes, oldest first",
      "items": {
        "$ref": "#/$defs/HistoryEvent"
      },
      "title": "History",
      "type": "array"
    }
  },
  "required": [
    "id",
    "title",
    "jurisdiction",
    "summary",
    "dates",
    "direction",
    "direction_rationale",
    "channels",
    "verified"
  ],
  "title": "Regulatory change record",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
