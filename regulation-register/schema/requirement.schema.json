{
  "$defs": {
    "DriverMark": {
      "additionalProperties": false,
      "description": "One driver's mark: -2 (major harm) to +2 (major gain). Drivers left out are marked 0.",
      "properties": {
        "driver": {
          "enum": [
            "entry-exit",
            "competition",
            "market-integration",
            "capital",
            "labour",
            "burden",
            "innovation",
            "prices-taxes"
          ],
          "title": "Driver",
          "type": "string"
        },
        "mark": {
          "maximum": 2,
          "minimum": -2,
          "title": "Mark",
          "type": "integer"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "positions": {
          "default": [],
          "description": "Where the effect lands on the Industry lens (entrants, smaller competitors, the largest players) when it differs from the driver's usual place (register/competition.py), e.g. an entry-exit mark about growing past a threshold",
          "items": {
            "enum": [
              "entrants",
              "smaller",
              "dominant"
            ],
            "type": "string"
          },
          "title": "Positions",
          "type": "array"
        }
      },
      "required": [
        "driver",
        "mark",
        "reason"
      ],
      "title": "DriverMark",
      "type": "object"
    },
    "Law": {
      "additionalProperties": false,
      "description": "An Act, regulation, instrument, code, planning scheme or local law, as on its official register.",
      "properties": {
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "jurisdiction": {
          "enum": [
            "CTH",
            "NSW",
            "VIC",
            "QLD",
            "WA",
            "SA",
            "TAS",
            "ACT",
            "NT"
          ],
          "title": "Jurisdiction",
          "type": "string"
        },
        "kind": {
          "enum": [
            "act",
            "regulation",
            "legislative-instrument",
            "code",
            "planning-instrument",
            "local-law",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "register_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. C2004A00109, or the register's own identifier",
          "title": "Register Id"
        },
        "register_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Register Url"
        },
        "provisions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. 's 9-5', 'Part 3, Division 2'",
          "title": "Provisions"
        },
        "applied": {
          "default": false,
          "description": "A national law hosted by another jurisdiction (e.g. the Health Practitioner Regulation National Law in Queensland's Act) that this jurisdiction applies as its own law",
          "title": "Applied",
          "type": "boolean"
        }
      },
      "required": [
        "title",
        "jurisdiction",
        "kind"
      ],
      "title": "Law",
      "type": "object"
    },
    "Reach": {
      "additionalProperties": false,
      "description": "Which businesses the requirement reaches.\n\n``scope`` \"all\" reaches every class (less ``exclude``). Otherwise ``classes`` lists ANZSIC codes at any level;\n``activities`` (only with 4-digit classes) limits the reach to those ABS primary activities, quoted exactly; and\n``condition`` limits it to businesses in the classes that also do something else (an activity that crosses\nclasses, such as selling alcohol).",
      "properties": {
        "scope": {
          "enum": [
            "all",
            "listed"
          ],
          "title": "Scope",
          "type": "string"
        },
        "classes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Classes",
          "type": "array"
        },
        "exclude": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Exclude",
          "type": "array"
        },
        "activities": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Activities",
          "type": "array"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Plain English: 'if the business sells alcohol'",
          "title": "Condition"
        },
        "legal_forms": {
          "default": [],
          "description": "Empty means every legal form",
          "items": {
            "enum": [
              "sole-proprietor",
              "partnership",
              "trust",
              "company",
              "co-operative",
              "incorporated-association"
            ],
            "type": "string"
          },
          "title": "Legal Forms",
          "type": "array"
        },
        "in_states": {
          "default": [],
          "description": "For a Commonwealth requirement: the states and territories it reaches; empty means all",
          "items": {
            "enum": [
              "CTH",
              "NSW",
              "VIC",
              "QLD",
              "WA",
              "SA",
              "TAS",
              "ACT",
              "NT"
            ],
            "type": "string"
          },
          "title": "In States",
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "sources": {
          "description": "Where the reach comes from, quoted",
          "items": {
            "$ref": "#/$defs/Source"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "scope",
        "sources"
      ],
      "title": "Reach",
      "type": "object"
    },
    "RequirementAssessment": {
      "additionalProperties": false,
      "description": "A requirement marked against the productivity impact framework, like a register item. Unlike an item, a small\nobligation may have no material effect on any driver (the framework's mark 0): it then has no marks and no main\ndriver, and the summary says why.",
      "properties": {
        "summary": {
          "description": "Plain English: what it does to productivity and competition",
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "marks": {
          "default": [],
          "description": "Empty when it has no material effect",
          "items": {
            "$ref": "#/$defs/DriverMark"
          },
          "title": "Marks",
          "type": "array"
        },
        "main_driver": {
          "anyOf": [
            {
              "enum": [
                "entry-exit",
                "competition",
                "market-integration",
                "capital",
                "labour",
                "burden",
                "innovation",
                "prices-taxes"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Main Driver"
        },
        "reach": {
          "enum": [
            "narrow",
            "sector",
            "multi-sector",
            "economy-wide"
          ],
          "title": "Reach",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "confidence_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Note"
        },
        "evidence": {
          "default": [],
          "description": "Sources for the marks beyond the record's own",
          "items": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "framework": {
          "default": "1.0",
          "description": "Framework version the marks follow",
          "title": "Framework",
          "type": "string"
        },
        "assessed_on": {
          "format": "date",
          "title": "Assessed On",
          "type": "string"
        }
      },
      "required": [
        "summary",
        "reach",
        "confidence",
        "assessed_on"
      ],
      "title": "RequirementAssessment",
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "description": "Whether a person has checked the record. Desk-research drafts start as ``draft``.",
      "properties": {
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "reviewed"
          ],
          "title": "Status",
          "type": "string"
        },
        "by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "By"
        },
        "on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "title": "Review",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "A source with the exact words that support a claim.",
      "properties": {
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "publisher": {
          "minLength": 1,
          "title": "Publisher",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Section, clause, page or heading",
          "title": "Locator"
        },
        "quote": {
          "description": "Exact words from the source",
          "minLength": 20,
          "title": "Quote",
          "type": "string"
        },
        "accessed": {
          "format": "date",
          "title": "Accessed",
          "type": "string"
        },
        "checked": {
          "enum": [
            "register-text",
            "document",
            "web-page",
            "corpus-copy"
          ],
          "title": "Checked",
          "type": "string"
        },
        "corpus_version_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The corpus document read, for 'corpus-copy'",
          "title": "Corpus Version Id"
        }
      },
      "required": [
        "title",
        "publisher",
        "url",
        "quote",
        "accessed",
        "checked"
      ],
      "title": "Source",
      "type": "object"
    },
    "Trigger": {
      "additionalProperties": false,
      "description": "What sets the requirement off.",
      "properties": {
        "type": {
          "enum": [
            "entry",
            "first-employee",
            "employees",
            "payroll",
            "turnover",
            "revenue",
            "assets",
            "quantity",
            "activity",
            "ongoing",
            "exit"
          ],
          "title": "Type",
          "type": "string"
        },
        "test": {
          "anyOf": [
            {
              "enum": [
                ">=",
                ">",
                "<=",
                "<"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Test"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. 'AUD a financial year', 'employees'",
          "title": "Unit"
        },
        "as_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When the value applied, as checked",
          "title": "As At"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Source"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "type"
      ],
      "title": "Trigger",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "family": {
      "description": "The same requirement across jurisdictions, e.g. 'food-business-registration'",
      "title": "Family",
      "type": "string"
    },
    "jurisdiction": {
      "enum": [
        "CTH",
        "NSW",
        "VIC",
        "QLD",
        "WA",
        "SA",
        "TAS",
        "ACT",
        "NT"
      ],
      "title": "Jurisdiction",
      "type": "string"
    },
    "tier": {
      "enum": [
        "cth",
        "state",
        "local"
      ],
      "title": "Tier",
      "type": "string"
    },
    "lga": {
      "anyOf": [
        {
          "pattern": "^\\d{5}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ABS LGA code (ASGS 2021), for a council",
      "title": "Lga"
    },
    "lga_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lga Name"
    },
    "regime": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The regime it belongs to (regulation-register/regimes)",
      "title": "Regime"
    },
    "title": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "kind": {
      "enum": [
        "registration",
        "licence",
        "approval",
        "notification",
        "tax-or-levy",
        "insurance",
        "reporting",
        "record-keeping",
        "standard",
        "other"
      ],
      "title": "Kind",
      "type": "string"
    },
    "what": {
      "description": "Plain English: what the business must do",
      "minLength": 1,
      "title": "What",
      "type": "string"
    },
    "laws": {
      "items": {
        "$ref": "#/$defs/Law"
      },
      "minItems": 1,
      "title": "Laws",
      "type": "array"
    },
    "sources": {
      "description": "The obligation in the law's own words",
      "items": {
        "$ref": "#/$defs/Source"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "administered_by": {
      "default": [],
      "description": "Bodies in bodies.json",
      "items": {
        "type": "string"
      },
      "title": "Administered By",
      "type": "array"
    },
    "administered_by_councils": {
      "default": false,
      "title": "Administered By Councils",
      "type": "boolean"
    },
    "triggers": {
      "items": {
        "$ref": "#/$defs/Trigger"
      },
      "minItems": 1,
      "title": "Triggers",
      "type": "array"
    },
    "reach": {
      "items": {
        "$ref": "#/$defs/Reach"
      },
      "minItems": 1,
      "title": "Reach",
      "type": "array"
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "confidence_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence Note"
    },
    "records": {
      "default": [],
      "description": "Register items about it",
      "items": {
        "type": "string"
      },
      "title": "Records",
      "type": "array"
    },
    "ablis": {
      "default": [],
      "description": "ABLIS service IDs, once checked against ABLIS",
      "items": {
        "type": "string"
      },
      "title": "Ablis",
      "type": "array"
    },
    "assessment": {
      "$ref": "#/$defs/RequirementAssessment",
      "description": "The requirement marked against the productivity impact framework (register/framework.py), against the same market without it"
    },
    "drafted_on": {
      "format": "date",
      "title": "Drafted On",
      "type": "string"
    },
    "review": {
      "$ref": "#/$defs/Review",
      "default": {
        "status": "draft",
        "by": null,
        "on": null,
        "notes": null
      }
    }
  },
  "required": [
    "id",
    "family",
    "jurisdiction",
    "tier",
    "title",
    "kind",
    "what",
    "laws",
    "sources",
    "triggers",
    "reach",
    "confidence",
    "assessment",
    "drafted_on"
  ],
  "title": "Requirement: what a law asks of a business, and the ANZSIC classes it reaches",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
