  "meta": {
    "title": "Mandatory climate-related financial disclosure (2024)",
    "summary": "Worked example (P6): a new reporting obligation with size thresholds. Large entities report climate-related risks under Australian sustainability standards, phased in by size: Group 1 from 2024-25, Group 2 from 2026-27 and Group 3 from 2027-28. The burden proposal rebuilds Treasury's regulatory burden estimate for Options 1, 1a and 1b (the recommended option, $1,150.2 million a year) from the Policy Impact Analysis's per-entity costs and entity counts; the thresholds screen the employee tests of each group.",
    "jurisdictions": [
      "CTH"
    ],
    "proposalType": "new",
    "startYear": 2024,
    "phaseInYears": 3,
    "durationYears": 10,
    "priceBase": "2025-26",
    "source": {
      "description": "Treasury, Policy Impact Analysis: Climate-related financial disclosures (September 2023), the regulatory burden estimate, pp. 16–29",
      "url": "https://treasury.gov.au/sites/default/files/2024-01/c2024-466491-pia.pdf",
      "vintage": "September 2023",
      "accessed": "2026-10-25"
    },
