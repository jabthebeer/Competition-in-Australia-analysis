<ACT STATE="TAS" YEAR="2021" ACTNO="20" BILLNO="42" BILLYEAR="2021" PRIVATE="NO" TYPE="ACT" AMENDING="PURE" PRINT.TYPE="ACT.NEW" VERSION.SERIES.ID="E517CC08-C981-4B8C-845B-1377137B0B8E" VERSION.DESC.ID="30767832-F073-426D-A97A-110DE7CFAEA7" ASSENT.DATE="2021-11-12" PRINTTYPE="act.new" PUBLICATION.DATE="2021-12-22" TITLE="Mutual Recognition (Tasmania) Amendment Act 2021" ID="act-2021-020" GUID="9d05f01c-9bde-4d28-ac5c-eb8c05809c48"><FRONT GUID="3bf4c07d-b30e-4599-a27b-dc9fcb243344"><CREST OLFILE="tascrest.gif" CRFILE="tascrest.tif"/><TITLE CHANGE="NOCHANGE" ID="AT/EN">Mutual Recognition (Tasmania) Amendment Act 2021</TITLE><LONGTITLE CHANGE="NOCHANGE" ID="Cl/EN"><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">An Act to amend the <ACTREF JURISDICTION="TAS" TITLE="Mutual Recognition (Tasmania) Act 1993" YEAR="1993" VERIFIED="NO" ACTNO="33">Mutual Recognition (Tasmania) Act 1993</ACTREF></TEXT></LONGTITLE><ASSENTDATE DAY="12" MONTH="NOVEMBER" YEAR="2021" HOUR="H00"/><ENACTINGWORDS TYPE="OTHER" COMMENCETYPE="C-OTHER" TARGETTYPE="WHOLE" OFFSETTYPE="NONE" OFFSETVALUE="0" ID="Cw/EN"><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">Be it enacted by Her Excellency the Governor of Tasmania, by and with the advice and consent of the Legislative Council and House of Assembly, in Parliament assembled, as follows:</TEXT></ENACTINGWORDS></FRONT><BODY><SECTION CHANGE="NOCHANGE" OMITTED="NOOMIT" SECNO="1" APPROPRIATE="NOAPP" COMMENCETYPE="C-OTHER" TARGETTYPE="WHOLE" OFFSETTYPE="NONE" OFFSETVALUE="0" NOFORMAT="ARABIC" TYPE="SHORTTITLE" ID="GS1/EN" GUID="b3c36ef1-c5f0-4257-9e48-cc5bdef47c26"><HEADNOTE CHANGE="NOCHANGE" ID="GS1/AN/EN">Short title</HEADNOTE><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">This Act may be cited as the <ACTREF JURISDICTION="TAS" TITLE="Mutual Recognition (Tasmania) Amendment Act 2021" YEAR="2021" VERIFIED="YES" ACTNO="20">Mutual Recognition (Tasmania) Amendment Act 2021</ACTREF>.</TEXT></SECTION><SECTION CHANGE="NOCHANGE" OMITTED="NOOMIT" SECNO="2" APPROPRIATE="NOAPP" CID="DEFAULT" COMMENCETYPE="PROCLAIMWHOLE" TARGETTYPE="WHOLE" OFFSETTYPE="NONE" OFFSETVALUE="0" NOFORMAT="ARABIC" TYPE="COMMENCE" ID="GS2/EN" GUID="f7424108-4d37-4bb6-90db-9255bab1b5fb"><HEADNOTE CHANGE="NOCHANGE" ID="GS2/AN/EN">Commencement</HEADNOTE><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">This Act commences on a day to be proclaimed.</TEXT></SECTION><SECTION CHANGE="NOCHANGE" OMITTED="NOOMIT" SECNO="3" APPROPRIATE="NOAPP" COMMENCETYPE="C-OTHER" TARGETTYPE="WHOLE" OFFSETTYPE="NONE" OFFSETVALUE="0" NOFORMAT="ARABIC" TYPE="PADEF" ID="GS3/EN" GUID="496e8cfa-f1c2-4e46-829b-1bbe965ce010"><HEADNOTE CHANGE="NOCHANGE" ID="GS3/AN/EN">Principal Act</HEADNOTE><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">In this Act, the <ACTREF JURISDICTION="TAS" TITLE="Mutual Recognition (Tasmania) Act 1993" YEAR="1993" VERIFIED="NO" ACTNO="33">Mutual Recognition (Tasmania) Act 1993</ACTREF> is referred to as the Principal Act.</TEXT></SECTION><SECTION CHANGE="NOCHANGE" OMITTED="NOOMIT" SECNO="4" APPROPRIATE="NOAPP" AAID="1" AMENDINGACTIONID="ZrN/RIux3oHBzQfnDW7GJA==" COMMENCETYPE="C-OTHER" TARGETTYPE="WHOLE" OFFSETTYPE="NONE" OFFSETVALUE="0" NOFORMAT="ARABIC" TYPE="AMEND" ID="GS4/EN" GUID="d142370b-e6b2-4ee7-af1a-87b09e62c3df"><HEADNOTE CHANGE="NOCHANGE" ID="GS4/AN/EN"><EXTREF JURISDICTION="TAS" TITLE="Mutual Recognition (Tasmania) Act 1993" YEAR="1993" SYSTEMPATH="GS3/EN" ACTNO="33" VERIFIED="YES">Section 3</EXTREF> amended (Interpretation)</HEADNOTE><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE"><EXTREF JURISDICTION="TAS" TITLE="Mutual Recognition (Tasmania) Act 1993" YEAR="1993" SYSTEMPATH="GS3/EN" ACTNO="33" VERIFIED="YES">Section 3 of the Principal Act</EXTREF> is amended by omitting <EXTREF JURISDICTION="TAS" TITLE="Mutual Recognition (Tasmania) Act 1993" YEAR="1993" SYSTEMPATH="GS3/Gs2/EN" ACTNO="33" VERIFIED="YES">subsection (2)</EXTREF>.</TEXT></SECTION><SECTION CHANGE="NOCHANGE" OMITTED="NOOMIT" SECNO="5" APPROPRIATE="NOAPP" COMMENCETYPE="C-OTHER" TARGETTYPE="WHOLE" OFFSETTYPE="NONE" OFFSETVALUE="0" NOFORMAT="ARABIC" TYPE="AMEND" ID="GS5/EN" GUID="db3a3527-dae3-42e4-ab1c-c7e0d8a5a74e"><HEADNOTE CHANGE="NOCHANGE" ID="GS5/AN/EN"><EXTREF JURISDICTION="TAS" TITLE="Mutual Recognition (Tasmania) Act 1993" YEAR="1993" SYSTEMPATH="GS4/EN" ACTNO="33" VERIFIED="YES">Section 4</EXTREF> amended (Adoption of Commonwealth Act)</HEADNOTE><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE"><EXTREF JURISDICTION="TAS" TITLE="Mutual Recognition (Tasmania) Act 1993" YEAR="1993" SYSTEMPATH="GS4/EN" ACTNO="33" VERIFIED="YES">Section 4 of the Principal Act</EXTREF> is amended as follows:</TEXT><PARAGRAPH OMITTED="NOOMIT" APPROPRIATE="NOAPP" CHANGE="NOCHANGE" AAID="2" AMENDINGACTIONID="nbHTq9VTrRee8mEX7BABnQ==" PARANO="a" NOFORMAT="BRLALPHA" TYPE="OTHER" COMMENCETYPE="C-OTHER" TARGETTYPE="WHOLE" OFFSETTYPE="NONE" OFFSETVALUE="0" ID="GS5/Hpa/EN"><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">by omitting from <EXTREF JURISDICTION="TAS" TITLE="Mutual Recognition (Tasmania) Act 1993" YEAR="1993" SYSTEMPATH="GS4/Gs2/EN" ACTNO="33" VERIFIED="YES">subsection (2)</EXTREF> <QUOTE QUOTEDFROM="TEXT"><INTREF SYSTEMPATH="GS4/Gs3/EN" VERIFIED="YES">subsection (3)</INTREF></QUOTE> and substituting <QUOTE QUOTEDFROM="TEXT"><INTREF SYSTEMPATH="GS4A/EN" VERIFIED="YES">section&#160;4A</INTREF></QUOTE>;</TEXT></PARAGRAPH><PARAGRAPH OMITTED="NOOMIT" APPROPRIATE="NOAPP" CHANGE="NOCHANGE" AAID="3" AMENDINGACTIONID="yOOzHULixb7Ohrkj6G5xcQ==" PARANO="b" NOFORMAT="BRLALPHA" TYPE="OTHER" COMMENCETYPE="C-OTHER" TARGETTYPE="WHOLE" OFFSETTYPE="NONE" OFFSETVALUE="0" ID="GS5/Hpb/EN"><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">by omitting <EXTREF JURISDICTION="TAS" TITLE="Mutual Recognition (Tasmania) Act 1993" YEAR="1993" SYSTEMPATH="GS4/Gs3/EN" ACTNO="33" VERIFIED="YES">subsections (3)</EXTREF> and <EXTREF JURISDICTION="TAS" TITLE="Mutual Recognition (Tasmania) Act 1993" YEAR="1993" SYSTEMPATH="GS4/Gs4/EN" ACTNO="33" VERIFIED="YES">(4)</EXTREF> and substituting the following subsections:</TEXT><ELEMENTQUOTE ELEMENTTYPE="OTHER" ID="GS5/Hpb/Je/EN"><SUBSECTION OMITTED="NOOMIT" CHANGE="NOCHANGE" SUBSECNO="3" APPROPRIATE="NOAPP" COMMENCETYPE="C-OTHER" TARGETTYPE="REMAINING" OFFSETTYPE="NONE" OFFSETVALUE="0" NOFORMAT="BRARABIC" TYPE="OTHER" ID="GS5/Hpb/Je/GS4/Gs3/EN"><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">Without limiting <INTREF SYSTEMPATH="GS4/Gs1/EN" VERIFIED="YES">subsection&#160;(1)</INTREF>, the amendments made to the Commonwealth Act by the <FOREIGN>Mutual Recognition Amendment Act 2021</FOREIGN> of the Commonwealth, as originally enacted, are adopted under paragraph (xxxvii) of section 51 of the Commonwealth Constitution.</TEXT></SUBSECTION><SUBSECTION OMITTED="NOOMIT" CHANGE="NOCHANGE" SUBSECNO="4" APPROPRIATE="NOAPP" COMMENCETYPE="C-OTHER" TARGETTYPE="REMAINING" OFFSETTYPE="NONE" OFFSETVALUE="0" NOFORMAT="BRARABIC" TYPE="OTHER" ID="GS5/Hpb/Je/GS4/Gs4/EN"><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">The adoption of the amendments to the Commonwealth Act under <INTREF SYSTEMPATH="GS4/Gs3/EN" VERIFIED="YES">subsection&#160;(3)</INTREF> has effect for a period commencing on the day on which the <ACTREF JURISDICTION="TAS" TITLE="Mutual Recognition (Tasmania) Amendment Act 2021" YEAR="2021" VERIFIED="YES" ACTNO="20">Mutual Recognition (Tasmania) Amendment Act 2021</ACTREF> commences and ending on whichever of the following first occurs:</TEXT><PARAGRAPH OMITTED="NOOMIT" APPROPRIATE="NOAPP" CHANGE="NOCHANGE" PARANO="a" NOFORMAT="BRLALPHA" TYPE="OTHER" COMMENCETYPE="C-OTHER" TARGETTYPE="WHOLE" OFFSETTYPE="NONE" OFFSETVALUE="0" ID="GS5/Hpb/Je/GS4/Gs4/Hpa/EN"><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">a day fixed under <INTREF SYSTEMPATH="GS4A/EN" VERIFIED="YES">section&#160;4A</INTREF> as the day on which the adoption of the amendments under <INTREF SYSTEMPATH="GS4/Gs3/EN" VERIFIED="YES">subsection&#160;(3)</INTREF> terminates;</TEXT></PARAGRAPH><PARAGRAPH OMITTED="NOOMIT" APPROPRIATE="NOAPP" CHANGE="NOCHANGE" PARANO="b" NOFORMAT="BRLALPHA" TYPE="OTHER" COMMENCETYPE="C-OTHER" TARGETTYPE="WHOLE" OFFSETTYPE="NONE" OFFSETVALUE="0" ID="GS5/Hpb/Je/GS4/Gs4/Hpb/EN"><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">the day fixed under <INTREF SYSTEMPATH="GS4A/EN" VERIFIED="YES">section&#160;4A</INTREF> as the day on which the adoption of the Commonwealth Act under <INTREF SYSTEMPATH="GS4/Gs1/EN" VERIFIED="YES">subsection&#160;(1)</INTREF> terminates.</TEXT></PARAGRAPH></SUBSECTION></ELEMENTQUOTE></PARAGRAPH></SECTION><SECTION CHANGE="NOCHANGE" OMITTED="NOOMIT" SECNO="6" APPROPRIATE="NOAPP" AAID="4" AMENDINGACTIONID="Csw3vYQjhTWLjVWIE1QSDQ==" COMMENCETYPE="C-OTHER" TARGETTYPE="WHOLE" OFFSETTYPE="NONE" OFFSETVALUE="0" NOFORMAT="ARABIC" TYPE="AMEND" ID="GS6/EN" GUID="3f1add32-a923-4b24-8102-5aff27b6c8b9"><HEADNOTE CHANGE="NOCHANGE" ID="GS6/AN/EN"><EXTREF JURISDICTION="TAS" TITLE="Mutual Recognition (Tasmania) Act 1993" YEAR="1993" SYSTEMPATH="GS4A/EN" ACTNO="33" VERIFIED="YES">Section 4A</EXTREF> inserted</HEADNOTE><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">After <EXTREF JURISDICTION="TAS" TITLE="Mutual Recognition (Tasmania) Act 1993" YEAR="1993" SYSTEMPATH="GS4/EN" ACTNO="33" VERIFIED="YES">section 4 of the Principal Act</EXTREF>, the following section is inserted:</TEXT><ELEMENTQUOTE ELEMENTTYPE="OTHER" ID="GS6/Je/EN"><SECTION CHANGE="NOCHANGE" OMITTED="NOOMIT" SECNO="4A" APPROPRIATE="NOAPP" COMMENCETYPE="C-OTHER" TARGETTYPE="WHOLE" OFFSETTYPE="NONE" OFFSETVALUE="0" NOFORMAT="ARABIC" TYPE="OTHER" ID="GS6/Je/GS4A/EN"><HEADNOTE CHANGE="NOCHANGE" ID="GS6/Je/GS4A/AN/EN">Termination of adoptions</HEADNOTE><SUBSECTION OMITTED="NOOMIT" CHANGE="NOCHANGE" SUBSECNO="1" APPROPRIATE="NOAPP" COMMENCETYPE="C-OTHER" TARGETTYPE="REMAINING" OFFSETTYPE="NONE" OFFSETVALUE="0" NOFORMAT="BRARABIC" TYPE="OTHER" ID="GS6/Je/GS4A/Gs1/EN"><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">The Governor may fix, by proclamation, a day as the day on which&#160;&#150;</TEXT><PARAGRAPH OMITTED="NOOMIT" APPROPRIATE="NOAPP" CHANGE="NOCHANGE" PARANO="a" NOFORMAT="BRLALPHA" TYPE="OTHER" COMMENCETYPE="C-OTHER" TARGETTYPE="WHOLE" OFFSETTYPE="NONE" OFFSETVALUE="0" ID="GS6/Je/GS4A/Gs1/Hpa/EN"><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">the adoption of the Commonwealth Act, under <INTREF SYSTEMPATH="GS4/Gs1/EN" VERIFIED="YES">section&#160;4(1)</INTREF>, terminates; or</TEXT></PARAGRAPH><PARAGRAPH OMITTED="NOOMIT" APPROPRIATE="NOAPP" CHANGE="NOCHANGE" PARANO="b" NOFORMAT="BRLALPHA" TYPE="OTHER" COMMENCETYPE="C-OTHER" TARGETTYPE="WHOLE" OFFSETTYPE="NONE" OFFSETVALUE="0" ID="GS6/Je/GS4A/Gs1/Hpb/EN"><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">the adoption of the amendments to the Commonwealth Act, under <INTREF SYSTEMPATH="GS4/Gs3/EN" VERIFIED="YES">section&#160;4(3)</INTREF>, terminates.</TEXT></PARAGRAPH></SUBSECTION><SUBSECTION OMITTED="NOOMIT" CHANGE="NOCHANGE" SUBSECNO="2" APPROPRIATE="NOAPP" COMMENCETYPE="C-OTHER" TARGETTYPE="REMAINING" OFFSETTYPE="NONE" OFFSETVALUE="0" NOFORMAT="BRARABIC" TYPE="OTHER" ID="GS6/Je/GS4A/Gs2/EN"><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">For the avoidance of doubt, if a proclamation is made under <INTREF SYSTEMPATH="GS4A/Gs1/EN" VERIFIED="YES">subsection&#160;(1)</INTREF> to terminate the adoption of the amendments to the Commonwealth Act under <INTREF SYSTEMPATH="GS4/Gs3/EN" VERIFIED="YES">section&#160;4(3)</INTREF>, the termination of the adoption of those amendments does not affect the continued operation in the State of the Commonwealth Act as adopted under <INTREF SYSTEMPATH="GS4/Gs1/EN" VERIFIED="YES">section&#160;4(1)</INTREF>.</TEXT></SUBSECTION></SECTION></ELEMENTQUOTE></SECTION><SECTION CHANGE="NOCHANGE" OMITTED="NOOMIT" SECNO="7" APPROPRIATE="NOAPP" COMMENCETYPE="C-OTHER" TARGETTYPE="WHOLE" OFFSETTYPE="NONE" OFFSETVALUE="0" NOFORMAT="ARABIC" TYPE="AMEND" ID="GS7/EN" GUID="d728597e-d898-40a2-9337-ee8a9ae68b5c"><HEADNOTE CHANGE="NOCHANGE" ID="GS7/AN/EN"><EXTREF JURISDICTION="TAS" TITLE="Mutual Recognition (Tasmania) Act 1993" YEAR="1993" SYSTEMPATH="GS5/EN" ACTNO="33" VERIFIED="YES">Section 5</EXTREF> amended (Reference of power to amend the Commonwealth Act)</HEADNOTE><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE"><EXTREF JURISDICTION="TAS" TITLE="Mutual Recognition (Tasmania) Act 1993" YEAR="1993" SYSTEMPATH="GS5/EN" ACTNO="33" VERIFIED="YES">Section 5 of the Principal Act</EXTREF> is amended as follows:</TEXT><PARAGRAPH OMITTED="NOOMIT" APPROPRIATE="NOAPP" CHANGE="NOCHANGE" AAID="5" AMENDINGACTIONID="n9yxf0KdtlwqqZfvlSC5Yg==" PARANO="a" NOFORMAT="BRLALPHA" TYPE="OTHER" COMMENCETYPE="C-OTHER" TARGETTYPE="WHOLE" OFFSETTYPE="NONE" OFFSETVALUE="0" ID="GS7/Hpa/EN"><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">by omitting from <EXTREF JURISDICTION="TAS" TITLE="Mutual Recognition (Tasmania) Act 1993" YEAR="1993" SYSTEMPATH="GS5/Gs1/EN" ACTNO="33" VERIFIED="YES">subsection (1)</EXTREF> <QUOTE QUOTEDFROM="TEXT"><EXTREF JURISDICTION="TAS" TITLE="Mutual Recognition Act 1992" YEAR="9999" SYSTEMPATH="" ACTNO="999" VERIFIED="NO">Commonwealth Act</EXTREF> as originally enacted relates but only to the extent of the amendment of that Act (other than the Schedules) in terms which are approved by the designated person for each of the then participating jurisdictions</QUOTE> and substituting <QUOTE QUOTEDFROM="TEXT">Commonwealth Act, as amended by the <FOREIGN>Mutual Recognition Amendment Act 2021</FOREIGN> of the Commonwealth, relates</QUOTE>;</TEXT></PARAGRAPH><PARAGRAPH OMITTED="NOOMIT" APPROPRIATE="NOAPP" CHANGE="NOCHANGE" AAID="6" AMENDINGACTIONID="sFXkcrL78b4srV8kaa1Mcw==" PARANO="b" NOFORMAT="BRLALPHA" TYPE="OTHER" COMMENCETYPE="C-OTHER" TARGETTYPE="WHOLE" OFFSETTYPE="NONE" OFFSETVALUE="0" ID="GS7/Hpb/EN"><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">by omitting <EXTREF JURISDICTION="TAS" TITLE="Mutual Recognition (Tasmania) Act 1993" YEAR="1993" SYSTEMPATH="GS5/Gs4/EN" ACTNO="33" VERIFIED="YES">subsection (4)</EXTREF> and substituting the following subsection:</TEXT><ELEMENTQUOTE ELEMENTTYPE="OTHER" ID="GS7/Hpb/Je/EN"><SUBSECTION OMITTED="NOOMIT" CHANGE="NOCHANGE" SUBSECNO="4" APPROPRIATE="NOAPP" COMMENCETYPE="C-OTHER" TARGETTYPE="REMAINING" OFFSETTYPE="NONE" OFFSETVALUE="0" NOFORMAT="BRARABIC" TYPE="OTHER" ID="GS7/Hpb/Je/GS5/Gs4/EN"><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">For the avoidance of doubt, the amendment of <INTREF SYSTEMPATH="GS5/Gs1/EN" VERIFIED="YES">subsection&#160;(1)</INTREF> by the <ACTREF JURISDICTION="TAS" TITLE="Mutual Recognition (Tasmania) Amendment Act 2021" YEAR="2021" VERIFIED="YES" ACTNO="20">Mutual Recognition (Tasmania) Amendment Act 2021</ACTREF> terminates such part of the reference that required the approval of terms by all participating jurisdictions.</TEXT></SUBSECTION></ELEMENTQUOTE></PARAGRAPH></SECTION><SECTION CHANGE="NOCHANGE" OMITTED="NOOMIT" SECNO="8" APPROPRIATE="NOAPP" AAID="7" AMENDINGACTIONID="+ClgbiBJtjn01uh5UTjViQ==" COMMENCETYPE="C-OTHER" TARGETTYPE="WHOLE" OFFSETTYPE="NONE" OFFSETVALUE="0" NOFORMAT="ARABIC" TYPE="AMEND" ID="GS8/EN" GUID="13e56c0a-fc2e-48f9-9c0e-cd4c92d6baf1"><HEADNOTE CHANGE="NOCHANGE" ID="GS8/AN/EN"><EXTREF JURISDICTION="TAS" TITLE="Mutual Recognition (Tasmania) Act 1993" YEAR="1993" SYSTEMPATH="GS6/EN" ACTNO="33" VERIFIED="YES">Section 6</EXTREF> substituted</HEADNOTE><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE"><EXTREF JURISDICTION="TAS" TITLE="Mutual Recognition (Tasmania) Act 1993" YEAR="1993" SYSTEMPATH="GS6/EN" ACTNO="33" VERIFIED="YES">Section 6 of the Principal Act</EXTREF> is repealed and the following section is substituted:</TEXT><ELEMENTQUOTE ELEMENTTYPE="OTHER" ID="GS8/Je/EN"><SECTION CHANGE="NOCHANGE" OMITTED="NOOMIT" SECNO="6" APPROPRIATE="NOAPP" COMMENCETYPE="C-OTHER" TARGETTYPE="WHOLE" OFFSETTYPE="NONE" OFFSETVALUE="0" NOFORMAT="ARABIC" TYPE="OTHER" ID="GS8/Je/GS6/EN"><HEADNOTE CHANGE="NOCHANGE" ID="GS8/Je/GS6/AN/EN">Parliamentary approval required for certain draft proclamations</HEADNOTE><SUBSECTION OMITTED="NOOMIT" CHANGE="NOCHANGE" SUBSECNO="1" APPROPRIATE="NOAPP" COMMENCETYPE="C-OTHER" TARGETTYPE="REMAINING" OFFSETTYPE="NONE" OFFSETVALUE="0" NOFORMAT="BRARABIC" TYPE="OTHER" ID="GS8/Je/GS6/Gs1/EN"><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">A proclamation is not to be made under <INTREF SYSTEMPATH="GS4A/Gs1/EN" VERIFIED="YES">section 4A(1)</INTREF> or <INTREF SYSTEMPATH="GS5/Gs3/EN" VERIFIED="YES">5(3)</INTREF> unless a draft of the proclamation is first approved by each House of Parliament.</TEXT></SUBSECTION><SUBSECTION OMITTED="NOOMIT" CHANGE="NOCHANGE" SUBSECNO="2" APPROPRIATE="NOAPP" COMMENCETYPE="C-OTHER" TARGETTYPE="REMAINING" OFFSETTYPE="NONE" OFFSETVALUE="0" NOFORMAT="BRARABIC" TYPE="OTHER" ID="GS8/Je/GS6/Gs2/EN"><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">For the purposes of <INTREF SYSTEMPATH="GS6/Gs1/EN" VERIFIED="YES">subsection&#160;(1)</INTREF>, a House of Parliament is taken to have approved a draft of a proclamation, as required under this section, if a copy of the draft has been laid on the table of the House and&#160;&#150;</TEXT><PARAGRAPH OMITTED="NOOMIT" APPROPRIATE="NOAPP" CHANGE="NOCHANGE" PARANO="a" NOFORMAT="BRLALPHA" TYPE="OTHER" COMMENCETYPE="C-OTHER" TARGETTYPE="WHOLE" OFFSETTYPE="NONE" OFFSETVALUE="0" ID="GS8/Je/GS6/Gs2/Hpa/EN"><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">it is approved by the House; or</TEXT></PARAGRAPH><PARAGRAPH OMITTED="NOOMIT" APPROPRIATE="NOAPP" CHANGE="NOCHANGE" PARANO="b" NOFORMAT="BRLALPHA" TYPE="OTHER" COMMENCETYPE="C-OTHER" TARGETTYPE="WHOLE" OFFSETTYPE="NONE" OFFSETVALUE="0" ID="GS8/Je/GS6/Gs2/Hpb/EN"><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">at the expiration of 5 sitting-days after it was laid on the table of the House&#160;&#150;</TEXT><SUBPARAGRAPH OMITTED="NOOMIT" APPROPRIATE="NOAPP" CHANGE="NOCHANGE" SUBPARANO="i" NOFORMAT="BRLROMAN" ID="GS8/Je/GS6/Gs2/Hpb/Hqi/EN"><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">there has been no notice given of a motion to disallow it; or</TEXT></SUBPARAGRAPH><SUBPARAGRAPH OMITTED="NOOMIT" APPROPRIATE="NOAPP" CHANGE="NOCHANGE" SUBPARANO="ii" NOFORMAT="BRLROMAN" ID="GS8/Je/GS6/Gs2/Hpb/Hqii/EN"><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">any notice of such a motion has been withdrawn or the motion has been negatived; or</TEXT></SUBPARAGRAPH></PARAGRAPH><PARAGRAPH OMITTED="NOOMIT" APPROPRIATE="NOAPP" CHANGE="NOCHANGE" PARANO="c" NOFORMAT="BRLALPHA" TYPE="OTHER" COMMENCETYPE="C-OTHER" TARGETTYPE="WHOLE" OFFSETTYPE="NONE" OFFSETVALUE="0" ID="GS8/Je/GS6/Gs2/Hpc/EN"><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">if a notice of a motion to disallow has been made during that period of 5 sitting-days and not determined at the expiration of the period&#160;&#150;</TEXT><SUBPARAGRAPH OMITTED="NOOMIT" APPROPRIATE="NOAPP" CHANGE="NOCHANGE" SUBPARANO="i" NOFORMAT="BRLROMAN" ID="GS8/Je/GS6/Gs2/Hpc/Hqi/EN"><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">the notice is withdrawn; or</TEXT></SUBPARAGRAPH><SUBPARAGRAPH OMITTED="NOOMIT" APPROPRIATE="NOAPP" CHANGE="NOCHANGE" SUBPARANO="ii" NOFORMAT="BRLROMAN" ID="GS8/Je/GS6/Gs2/Hpc/Hqii/EN"><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">the motion has been negatived.</TEXT></SUBPARAGRAPH></PARAGRAPH></SUBSECTION></SECTION></ELEMENTQUOTE></SECTION><SECTION CHANGE="NOCHANGE" OMITTED="NOOMIT" SECNO="9" APPROPRIATE="NOAPP" COMMENCETYPE="C-OTHER" TARGETTYPE="WHOLE" OFFSETTYPE="NONE" OFFSETVALUE="0" NOFORMAT="ARABIC" TYPE="TRANSITION" ID="GS9/EN" GUID="6004a9a8-78dc-4d7f-8e3c-1a691f6e97ca"><HEADNOTE CHANGE="NOCHANGE" ID="GS9/AN/EN">Repeal of Act</HEADNOTE><TEXT BREAKBEFORE="BREAK" CHANGE="NOCHANGE">This Act is repealed on the first anniversary of the day on which it commenced.</TEXT></SECTION></BODY><TAIL><READINGDATES><LOWERHOUSE DAY="12" MONTH="OCTOBER" YEAR="2021" HOUR="H00"/><UPPERHOUSE DAY="27" MONTH="OCTOBER" YEAR="2021" HOUR="H00"/></READINGDATES></TAIL></ACT>