      "measure": "productivity and real pay",
      "frequency": "financial-year",
      "unit": "state x ANZSIC division",
      "estimator": "stacked difference-in-differences against the other divisions",
      "placebo_pools": [
        {
          "kind": "industries",
          "rule": "the other ANZSIC divisions"
        }
      ],
