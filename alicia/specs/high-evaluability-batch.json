      "frequency": "quarterly",
      "unit": "capital city",
      "estimator": "stacked difference-in-differences; detrended variant as robustness",
      "placebo_pools": [
        {
          "kind": "cpi-classes",
          "rule": "every class outside the case's related subgroups"
        }
      ],
      "notes": [
        "Only cases with a matching CPI class (price in cases); role per case."
      ]
    },
    {
      "key": "productivity",
      "label": "Output and real pay per worker in the case's division",
