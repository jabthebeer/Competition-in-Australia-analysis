      "frequency": "financial-year",
      "unit": "state x ANZSIC class group",
      "estimator": "stacked difference-in-differences, net of placebo industry groups",
      "placebo_pools": [
        {
          "kind": "industries",
          "rule": "as for entries"
        }
      ]
    },
    {
      "key": "prices",
      "label": "Relative consumer price: 100 x log(CPI class / All groups), capital cities",
      "role": "secondary",
      "source": "ABS CPI 17th series (Data API, 2001-Q1 to 2019-Q4)",
