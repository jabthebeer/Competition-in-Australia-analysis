  "hypothesis": "mixed",
  "outcomes": [
    {
      "key": "business",
      "label": "Business entry and exit rates per 100 businesses at the start of the year",
      "role": "primary",
      "source": "data/processed/abs_cabee/cabee_class_state_fy.csv.gz (all 15 releases, latest vintage)",
      "measure": "entries, exits",
      "frequency": "financial-year",
      "unit": "ANZSIC class x state",
      "estimator": "per case: the layer chosen in the blinded power study (saturated fixed effects, synthetic DiD or two-way)",
      "placebo_pools": [
        {
          "kind": "industries",
          "rule": "size-matched placebo class groups outside the treated divisions (up to 40), as the high-evaluability batch"
        },
        {
          "kind": "units",
          "rule": "the reform's own classes in states that never adopted it (robustness)"
        },
        {
          "kind": "dates",
          "rule": "the reform's own classes and states at earlier, fake dates (robustness)"
        }
      ],
      "notes": [
        "Cohorts, classes, windows and the registered layer are per case (cases)."
      ]
    },
    {
      "key": "prices",
      "label": "100 x log(CPI class / All groups), capital city x quarter",
      "role": "primary",
      "source": "ABS CPI 17th series, 2001-Q1 to 2025-Q3",
      "measure": "relative price",
      "frequency": "quarterly",
      "unit": "CPI class x capital city",
      "estimator": "class x quarter and city x quarter fixed effects (saturated), or synthetic DiD where registered",
      "placebo_pools": [
        {
          "kind": "cpi-classes",
          "rule": "up to 40 CPI classes outside the case's related subgroups"
        }
      ]
    }
  ],
  "stages": [
